---
// Diagrama unifilar del sistema de respaldo. Cada bloque enlaza a su página.
// El botón recorre tres estados reales: red normal, falla de red (baterías) y planta en operación.
import { u } from '../lib/site.js';
const N = [
  { id: 'red', x: 16, y: 26, t1: 'Red eléctrica', t2: 'suministro', href: '/servicios/instalacion-y-dimensionamiento/' },
  { id: 'planta', x: 16, y: 330, t1: 'Planta de', t2: 'emergencia', href: '/productos/plantas-de-emergencia/' },
  { id: 'tab', x: 214, y: 178, t1: 'Tablero de', t2: 'transferencia', href: '/productos/tableros-de-transferencia/' },
  { id: 'ups', x: 412, y: 178, t1: 'UPS', t2: 'en línea', href: '/productos/ups/' },
  { id: 'bat', x: 412, y: 330, t1: 'Banco de', t2: 'baterías', href: '/productos/baterias-industriales/baterias-para-ups/' },
  { id: 'carga', x: 412, y: 26, t1: 'Carga', t2: 'crítica', href: '/nosotros/' },
];
const L = [
  { id: 'l-red', d: 'M188 56 H300 V178' },
  { id: 'l-planta', d: 'M188 360 H300 V238' },
  { id: 'l-tab', d: 'M386 208 H412' },
  { id: 'l-carga', d: 'M498 178 V86' },
  { id: 'l-bat', d: 'M498 238 V330' },
];
---
<figure class="uni" data-state="normal" aria-labelledby="uni-cap">
  <svg viewBox="0 0 600 400" role="group" aria-label="Diagrama del sistema de respaldo de CBPS">
    <defs>
      <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.18" /></pattern>
    </defs>
    <rect x="0" y="0" width="600" height="400" fill="url(#grid)" class="uni__grid" />
    {L.map((l) => (<g class={`ln ${l.id}`}><path class="ln__base" d={l.d} /><path class="ln__flow" d={l.d} /></g>))}
    {N.map((n) => (
      <a href={u(n.href)} class={`nd nd--${n.id}`}>
        <rect x={n.x} y={n.y} width="172" height="60" rx="6" />
        <text x={n.x + 16} y={n.y + 26} class="nd__t">{n.t1}</text>
        <text x={n.x + 16} y={n.y + 46} class="nd__t">{n.t2}</text>
        <circle class="nd__led" cx={n.x + 154} cy={n.y + 18} r="5" />
      </a>
    ))}
  </svg>
  <figcaption id="uni-cap">
    <span class="uni__st" aria-live="polite" data-st>Red normal: la carga crítica se alimenta de la red a través del UPS y las baterías se mantienen cargadas.</span>
    <button class="btn btn--ghost uni__btn" type="button" data-sim>Simular falla de la red</button>
  </figcaption>
</figure>

<style>
  .uni { margin: 0; color: var(--blue-deep); }
  .uni svg { width: 100%; height: auto; display: block; overflow: visible; }
  .uni__grid { color: var(--blue); }
  .ln__base { fill: none; stroke: #9fb0bd; stroke-width: 3; stroke-dasharray: 2 7; stroke-linecap: round; transition: stroke 300ms ease; }
  .ln__flow { fill: none; stroke: var(--blue); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 10 14; opacity: 0; transition: opacity 300ms ease; }
  .ln.on .ln__base { stroke: var(--blue); stroke-dasharray: none; }
  .ln.on .ln__flow { opacity: 1; stroke: var(--amber); animation: flow 900ms linear infinite; }
  .ln.rev .ln__flow { animation-direction: reverse; }
  .ln.slow .ln__flow { animation-duration: 2.4s; stroke-dasharray: 4 20; }
  @keyframes flow { to { stroke-dashoffset: -24; } }
  .nd rect { fill: #fff; stroke: #9fb0bd; stroke-width: 1.5; transition: stroke 250ms ease, fill 250ms ease; }
  .nd__t { font: 600 15px var(--f-body); fill: var(--ink); }
  .nd__led { fill: #fff; stroke: #6b7c89; stroke-width: 2; transition: fill 250ms ease, stroke 250ms ease; }
  .nd.on rect { stroke: var(--blue); stroke-width: 2; }
  .nd.on .nd__led { fill: var(--green); stroke: var(--green-deep); }
  .nd.off rect { fill: #eef2f5; stroke-dasharray: 5 4; }
  .nd:focus-visible rect, .nd:hover rect { stroke: var(--blue-deep); stroke-width: 2.5; }
  .nd:focus { outline: none; }
  .uni figcaption { display: grid; gap: 12px; margin-top: 14px; }
  .uni__st { font-size: 0.95rem; color: var(--steel); min-height: 3.2em; }
  .uni__btn { justify-self: start; }
  /* estados: qué líneas llevan energía */
  .uni[data-state='normal'] :is(.l-red, .l-tab, .l-carga) { }
  @media (max-width: 620px) { .nd__t { font-size: 21px; } .nd__led { r: 6px; } }
  @media (prefers-reduced-motion: reduce) { .ln.on .ln__flow { animation: none; stroke-dasharray: none; stroke: var(--blue); } }
</style>

<script>
  const ESTADOS = {
    normal: { on: ['l-red', 'l-tab', 'l-carga', 'l-bat'], slow: ['l-bat'], rev: [], nodos: ['red', 'tab', 'ups', 'bat', 'carga'], off: ['planta'],
      txt: 'Red normal: la carga crítica se alimenta de la red a través del UPS y las baterías se mantienen cargadas.', btn: 'Simular falla de la red' },
    falla: { on: ['l-carga', 'l-bat'], slow: [], rev: ['l-bat'], nodos: ['ups', 'bat', 'carga'], off: ['red', 'tab', 'planta'],
      txt: 'Falla de la red: el UPS toma la energía de las baterías sin cortar la carga, mientras la planta arranca.', btn: 'Continuar: arranca la planta' },
    planta: { on: ['l-planta', 'l-tab', 'l-carga', 'l-bat'], slow: ['l-bat'], rev: [], nodos: ['planta', 'tab', 'ups', 'bat', 'carga'], off: ['red'],
      txt: 'Planta en operación: el tablero transfirió la carga a la planta y el UPS vuelve a cargar las baterías.', btn: 'Restablecer la red' },
  };
  const orden = ['normal', 'falla', 'planta'];
  document.querySelectorAll('.uni').forEach((fig) => {
    const pinta = (k) => {
      const e = ESTADOS[k]; fig.dataset.state = k;
      fig.querySelectorAll('.ln').forEach((l) => { const id = [...l.classList].find((c) => c.startsWith('l-')); l.classList.toggle('on', e.on.includes(id)); l.classList.toggle('slow', e.slow.includes(id)); l.classList.toggle('rev', e.rev.includes(id)); });
      fig.querySelectorAll('.nd').forEach((n) => { const id = [...n.classList].find((c) => c.startsWith('nd--')).slice(4); n.classList.toggle('on', e.nodos.includes(id)); n.classList.toggle('off', e.off.includes(id)); });
      fig.querySelector('[data-st]').textContent = e.txt; fig.querySelector('[data-sim]').textContent = e.btn;
    };
    pinta('normal');
    fig.querySelector('[data-sim]').addEventListener('click', () => pinta(orden[(orden.indexOf(fig.dataset.state) + 1) % 3]));
  });
</script>
