---
import Base from '../layouts/Base.astro';
import Cotizar from '../components/Cotizar.astro';
import { u } from '../lib/site.js';
import { LINEAS, SERVICIOS } from '../lib/nav.js';
---
<Base title="Página no encontrada" desc="La página que buscas no existe o cambió de dirección." ruta="/404/" noindex>
  <section class="wrap" style="padding-block:72px 96px">
    <p class="kicker">Error 404</p>
    <h1>Esta página no existe o cambió de dirección</h1>
    <p class="lead">Revisa la dirección o entra por una de las líneas principales.</p>
    <ul class="chips" style="margin-top:24px">
      <li><a href={u('/')}>Inicio</a></li>
      {[SERVICIOS[0], LINEAS[0], LINEAS[1]].map((l) => <li><a href={u(l.ruta)}>{l.nombre}</a></li>)}
      <li><a href={u('/servicios/')}>Servicios</a></li>
      <li><a href={u('/contacto/')}>Contacto</a></li>
    </ul>
  </section>
  <Cotizar />
</Base>
