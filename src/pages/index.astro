---
import Base from '../layouts/Base.astro';
import Unifilar from '../components/Unifilar.astro';
import Cotizar from '../components/Cotizar.astro';
import Icono from '../components/Icono.astro';
import { PAGINAS, POSTS } from '../lib/paginas.js';
import { LINEAS, SERVICIOS } from '../lib/nav.js';
import { u, waCotizar, waOrientacion, PROD } from '../lib/site.js';
import { tc } from '../lib/util.js';

// fotos reales del sitio de CBPS para las tres líneas principales (sus páginas no traen imagen propia)
const FOTOS = {
  '/productos/plantas-de-emergencia/': { src: '2026_07_whatsapp-image-2026-01-15-at-8-26-48-pm-e1790788687806.webp', w: 1028, h: 696, alt: 'Planta de emergencia CBPS en caseta acústica instalada en exterior' },
  '/productos/ups/': { src: '2024_08_todas-las-bateria-facebook-ad-1.webp', w: 1100, h: 576, alt: 'Gabinetes de sistemas UPS de distintas capacidades' },
  '/productos/baterias-industriales/': { src: '2026_07_cbps-31-jul-2026-12_12_49-p-m.webp', w: 1100, h: 733, alt: 'Batería sellada VRLA para respaldo de UPS' },
};
const prio = LINEAS.slice(0, 3).map((l) => ({ ...l, media: FOTOS[l.ruta] || PAGINAS[l.ruta]?.media }));
const otras = LINEAS.slice(3);
const eslabones = [
  { n: 'Instalación eléctrica', r: '/servicios/instalacion-y-dimensionamiento/', t: 'El cimiento de todo. Desde la acometida hasta el último contacto, la continuidad y la seguridad deben ser confiables.' },
  { n: 'Planta de emergencia', r: '/productos/plantas-de-emergencia/', t: 'Respaldo ante falla de red. Una segunda fuente de energía que controlas tú, a libre demanda.' },
  { n: 'UPS', r: '/productos/ups/', t: 'Protección ante disturbios eléctricos. Servidores y equipos digitales reciben una senoidal pura, con o sin redundancia.' },
  { n: 'Baterías', r: '/productos/baterias-industriales/', t: 'El momento de verdad. En una interrupción, todo depende de ellas: hay que mantenerlas y sustituirlas a tiempo.' },
  { n: 'Aire acondicionado de precisión', r: '/productos/aire-de-precision/', t: 'Control térmico crítico. La integridad del site y la vida de las baterías dependen de la temperatura y la humedad.' },
  { n: 'Factor humano', r: '/servicios/mantenimiento/', t: 'El eslabón que nadie revisa. Un sistema bien diseñado también necesita personal capacitado para operarlo.' },
];
const testimonios = [
  { q: 'Sabemos que ante eventualidades y continuidad del negocio no cualquier proveedor es confiable. CBPS es uno de esos pocos confiables.', n: 'Verónica Rodríguez', c: 'Gerenta de Ventas, SYD México' },
  { q: 'El mantenimiento de nuestras diferentes plantas de emergencia y UPS en sitio está en buenas manos con CBPS.', n: 'Ing. Oscar Aguirre', c: 'Gerente de Mantenimiento, Swissport' },
  { q: 'El apoyo y asesoría de la empresa CBPS ha sido útil en varias ocasiones. Se trabaja libre de problemas.', n: 'Ing. Oscar Díaz', c: 'Ing. de Infraestructura, INEGI' },
  { q: 'CBPS es una empresa seria y fiel con sus clientes. Hemos adquirido UPS y su apoyo ha sido incondicional.', n: 'Ing. Edwind Mancilla', c: 'Gerente de Mantenimiento e Infraestructura, Afianzadora Aserta' },
];
const marcas = [
  ['Generac', '/productos/plantas-de-emergencia/generac/'], ['IGSA', '/productos/plantas-de-emergencia/igsa/'], ['PLANELEC', '/productos/plantas-de-emergencia/planelec/'],
  ['Eaton', '/productos/ups/eaton/'], ['Vertiv', '/productos/ups/vertiv/'], ['CyberPower', '/productos/ups/cyberpower/'], ['ABB', '/productos/ups/abb/'], ['Industronic', '/productos/ups/industronic/'], ['Powest', '/productos/ups/powest/'],
  ['CSB', '/productos/baterias-industriales/csb/'], ['C&D', '/productos/baterias-industriales/c-and-d/'], ['EnerSys', '/productos/baterias-industriales/enersys/'], ['Kaise', '/productos/baterias-industriales/kaise/'], ['Invermexa', '/productos/baterias-industriales/invermexa/'], ['LTH', '/productos/baterias-industriales/lth/'], ['América', '/productos/baterias-industriales/america/'], ['Trojan', '/productos/baterias-industriales/trojan/'], ['Crown', '/productos/baterias-industriales/crown/'],
  ['STULZ', '/productos/aire-de-precision/stulz/'], ['HiRef', '/productos/aire-de-precision/hiref/'], ['VOGAR', '/productos/reguladores-de-voltaje/vogar/'], ['Power All', '/productos/reguladores-de-voltaje/power-all/'], ['RPSM', '/productos/reguladores-de-voltaje/rpsm/'],
];
const filaA = marcas.slice(0, 12), filaB = marcas.slice(12);
const problema = 'Hay operaciones donde un microcorte representa minutos de pérdida. En otras significa detener producción, comprometer información o poner en riesgo la continuidad. La diferencia entre una solución que parcha y un sistema que protege está en diseñarlo completo. Eso es lo que hacemos en CBPS.';
const fecha = (iso) => iso ? new Date(iso).toLocaleDateString('es-MX', { month: 'long', year: 'numeric', timeZone: 'America/Mexico_City' }) : '';
const recientes = POSTS.slice(0, 4);
const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'CBPS', url: `${PROD}/`, inLanguage: 'es-MX' }];
---
<Base title="CBPS | Plantas de emergencia, UPS y baterías industriales para cargas críticas" desc="CBPS diseña sistemas de protección para cargas críticas: suministro, dimensionamiento, instalación y mantenimiento de plantas de emergencia, UPS y baterías industriales en México." ruta="/" canon="/" schema={schema}>

  <section class="hero" aria-labelledby="hero-t">
    <div class="wrap hero__grid">
      <div class="hero__txt">
        <p class="kicker hero__k">Critical Business Power Systems</p>
        <h1 id="hero-t">Protección de cargas críticas diseñada con ingeniería</h1>
        <p class="lead">Plantas de emergencia, sistemas UPS y baterías industriales integrados en un solo sistema. Antes de recomendar un equipo, entendemos qué está realmente en riesgo en tu operación.</p>
        <div class="btns">
          <a class="btn btn--wa" href={waCotizar()} target="_blank" rel="noopener" data-ev="whatsapp"><Icono n="wa" />Cotizar por WhatsApp</a>
          <a class="btn btn--ghost-light" href={waOrientacion()} target="_blank" rel="noopener" data-ev="whatsapp-orientacion">Pedir orientación técnica</a>
        </div>
        <ul class="hero__lines" aria-label="Líneas principales">
          {prio.map((l) => <li><a href={u(l.ruta)}>{l.nombre}<Icono n="flecha" /></a></li>)}
        </ul>
      </div>
      <div class="hero__fig"><Unifilar /></div>
    </div>
  </section>

  <section class="brandband" aria-labelledby="marcas-t">
    <div class="wrap brandband__head">
      <h2 id="marcas-t">Solo marcas comprometidas con sus clientes</h2>
      <p>Existen decenas de marcas para cada segmento. En CBPS solo trabajamos con las que consideramos comprometidas con los clientes y que vale la pena recomendar por experiencia, calidad y servicio.</p>
    </div>
    <div class="marq" style="--dur:46s">
      <ul class="marq__track">{filaA.map(([n, r]) => <li><a href={u(r)}>{n}</a></li>)}</ul>
      <ul class="marq__track" aria-hidden="true">{filaA.map(([n]) => <li><span>{n}</span></li>)}</ul>
    </div>
    <div class="marq marq--rev" style="--dur:40s">
      <ul class="marq__track">{filaB.map(([n, r]) => <li><a href={u(r)}>{n}</a></li>)}</ul>
      <ul class="marq__track" aria-hidden="true">{filaB.map(([n]) => <li><span>{n}</span></li>)}</ul>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="dolor-t">
    <div class="wrap split">
      <div class="rv">
        <p class="kicker">¿Esto te suena familiar?</p>
        <h2 id="dolor-t">El problema no es la falta de equipos. Es la falta de integración.</h2>
      </div>
      <div>
        <ul class="asks" data-stagger>
          <li>¿Dependes de energía continua para operar y cualquier interrupción puede traer consecuencias reales?</li>
          <li>¿Has tenido fallas eléctricas sin saber con claridad la causa o su origen?</li>
          <li>¿Tus soluciones actuales dependen de proveedores que no conocen tu operación completa?</li>
        </ul>
        <p class="words" data-words>{problema.split(' ').map((w) => <span class="w">{w} </span>)}</p>
      </div>
    </div>
  </section>

  <section class="band band--night chain-band" aria-labelledby="chain-t">
    <div class="wrap">
      <div class="chain-head rv">
        <p class="kicker">Los 6 eslabones de la continuidad</p>
        <h2 id="chain-t">Un sistema es tan fuerte como su eslabón más débil</h2>
        <p>Cada eslabón tiene un rol específico. Ninguno protege solo. Todos protegen juntos.</p>
      </div>
      <ol class="chain" data-chain>
        {eslabones.map((e) => (
          <li><a href={u(e.r)}><strong>{e.n}</strong><span>{e.t}</span></a></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="lineas-t">
    <div class="wrap">
      <div class="sec-head rv">
        <p class="kicker">Encuentra la solución que necesitas</p>
        <h2 id="lineas-t">Plantas, UPS y baterías: las tres líneas que sostienen tu operación</h2>
      </div>
      <div class="prio">
        {prio.map((l, i) => (
          <article class={`prio__it rv${i === 0 ? ' prio__it--big' : ''}`} style={`--d:${i * 90}ms`} data-spot>
            <a href={u(l.ruta)} class="prio__img" tabindex="-1" aria-hidden="true">{l.media && <img src={u('/img/' + l.media.src)} alt="" width={l.media.w} height={l.media.h} loading="lazy" decoding="async" />}</a>
            <div class="prio__tx">
              <h3><a href={u(l.ruta)}>{l.nombre}</a></h3>
              <p>{l.resumen}</p>
              <ul class="chips">{l.hijos.filter((h) => !h.grupo).slice(0, 6).map((h) => <li><a href={u(h.ruta)}>{h.nombre}</a></li>)}{l.hijos.filter((h) => h.grupo).map((h) => <li><a href={u(h.ruta)}>{h.nombre}</a></li>)}</ul>
            </div>
          </article>
        ))}
      </div>
      <div class="otras">
        <h3 class="rv">Otras líneas para proteger cargas críticas</h3>
        <ul class="rows" data-stagger>{otras.map((l) => <li><a href={u(l.ruta)}><strong>{l.nombre}</strong><span>{l.resumen}</span><Icono n="flecha" /></a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="serv-t">
    <div class="wrap split split--top">
      <div class="serv-intro">
        <div class="rv">
          <p class="kicker">Servicios</p>
          <h2 id="serv-t">Actuamos como extensión técnica de nuestros clientes</h2>
          <p>No somos una empresa que vende equipos y desaparece. Somos el equipo de ingeniería que muchas organizaciones no tienen internamente y necesitan para tomar decisiones correctas sobre su infraestructura crítica.</p>
        </div>
        <figure class="serv-photo rv-clip">
          <img src={u('/img/2026_07_whatsapp-image-2026-01-15-at-8-27-39-pm-e1790788813223.webp')} alt="Planta de emergencia CBPS con las puertas de la caseta abiertas para servicio" width="1057" height="730" loading="lazy" decoding="async" />
        </figure>
        <dl class="princ" data-stagger>
          <div><dt>Ingeniería propia</dt><dd>El proceso siempre comienza con un diagnóstico técnico, no con un catálogo.</dd></div>
          <div><dt>Diagnóstico antes de vender</dt><dd>Nunca recomendamos un equipo sin entender el sistema completo.</dd></div>
          <div><dt>Acompañamiento real</dt><dd>Desde el diseño hasta la operación, el mantenimiento y la capacitación.</dd></div>
        </dl>
      </div>
      <ul class="rows" data-stagger>
        {SERVICIOS.map((s) => <li><a href={u(s.ruta)}><strong>{s.nombre}</strong><span>{s.resumen}</span><Icono n="flecha" /></a></li>)}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="test-t">
    <div class="wrap">
      <div class="sec-head rv">
        <p class="kicker">Lo que dicen nuestros clientes</p>
        <h2 id="test-t">Plantas y UPS en buenas manos</h2>
      </div>
      <div class="tests">
        {testimonios.map((t, i) => (
          <figure class={`test rv${i === 0 ? ' test--lead' : ''}`} style={`--d:${i * 80}ms`}>
            <blockquote><p>{t.q}</p></blockquote>
            <figcaption><strong>{t.n}</strong><span>{t.c}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="blog-t">
    <div class="wrap">
      <div class="sec-head sec-head--row rv">
        <div><p class="kicker">Blog Electric Leaders</p><h2 id="blog-t">Aprende a proteger tus cargas críticas</h2></div>
        <a class="btn btn--ghost" href={u('/blog/')}>Ver todas las publicaciones</a>
      </div>
      <ul class="rows" data-stagger>{recientes.map((q) => <li><a href={u(q.ruta)}><strong>{tc(q.h1)}</strong><span>{fecha(q.published)}</span><Icono n="flecha" /></a></li>)}</ul>
    </div>
  </section>

  <Cotizar titulo="¿Por dónde quieres empezar?" texto="No importa si apenas estás explorando o si ya tienes una urgencia concreta: hay un camino para ti. La consulta es gratuita; ignorar una falla puede resultar muy costoso." />
</Base>

<style>
  /* ---------- héroe: tablero de noche con el diagrama vivo ---------- */
  .hero { position: relative; overflow: hidden; color: var(--on-night); padding-block: clamp(40px, 6vw, 84px) clamp(56px, 8vw, 110px);
    background: radial-gradient(760px 520px at 78% 30%, rgba(21, 134, 188, 0.34), transparent 62%), radial-gradient(520px 380px at 8% 100%, rgba(41, 149, 70, 0.16), transparent 70%), var(--grid-night), var(--night); }
  .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: linear-gradient(90deg, var(--blue), var(--green) 55%, transparent); transform-origin: 0 50%; }
  .hero__grid { position: relative; display: grid; gap: 44px; align-items: center; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: 1fr 1.08fr; gap: 64px; } }
  .hero h1 { color: #fff; font-size: clamp(2.3rem, 1.3rem + 3.2vw, 4.1rem); font-stretch: 106%; font-weight: 800; letter-spacing: -0.025em; line-height: 1; max-width: 17ch; }
  .hero .kicker { color: var(--sky); }
  .hero .lead { color: var(--on-night-2); margin-bottom: 30px; max-width: 52ch; }
  .hero__lines { list-style: none; padding: 0; margin: 36px 0 0; display: grid; border-top: 1px solid rgba(143, 208, 240, 0.2); }
  .hero__lines a { position: relative; display: flex; justify-content: space-between; align-items: center; padding: 15px 4px; border-bottom: 1px solid rgba(143, 208, 240, 0.2); color: #fff; text-decoration: none; font: 650 1.1rem var(--f-display); font-stretch: 108%; transition: padding 360ms var(--ease-out), color 200ms ease; }
  .hero__lines a::before { content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%; background: var(--sky); transform: scaleX(0); transform-origin: 0 50%; transition: transform 500ms var(--ease-out); }
  .hero__lines svg { width: 20px; height: 20px; color: var(--sky); transition: transform 300ms var(--ease-out); }
  @media (hover: hover) { .hero__lines a:hover { padding-left: 12px; color: var(--sky); } .hero__lines a:hover::before { transform: none; } .hero__lines a:hover svg { transform: translateX(6px); } }
  .hero__fig { position: relative; background: rgba(9, 24, 37, 0.62); border-radius: 20px; padding: clamp(14px, 2.4vw, 24px); box-shadow: 0 50px 100px -50px rgba(0, 0, 0, 0.9), inset 0 0 0 1px rgba(143, 208, 240, 0.16); backdrop-filter: blur(6px); }
  .hero__fig::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; background: linear-gradient(150deg, rgba(143, 208, 240, 0.85), transparent 35%, transparent 70%, rgba(95, 209, 127, 0.5)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
  /* entrada única y orquestada del héroe: el titular se «expande» como una barra que se energiza */
  @media (prefers-reduced-motion: no-preference) {
    .hero__txt > * { animation: up 760ms var(--ease-out) both; }
    .hero h1 { animation: stretch 1300ms 80ms var(--ease-out) both; }
    .hero__txt > *:nth-child(3) { animation-delay: 200ms; } .hero__txt > *:nth-child(4) { animation-delay: 280ms; } .hero__txt > *:nth-child(5) { animation-delay: 360ms; }
    .hero__fig { animation: figIn 1000ms 220ms var(--ease-out) both; }
    .hero::after { animation: wire 1600ms 300ms var(--ease-io) both; }
  }
  @keyframes figIn { from { opacity: 0; transform: translateY(26px) scale(0.97); } }

  /* ---------- marcas en marquesina (pausa al pasar o enfocar) ---------- */
  .brandband { background: var(--surface); padding-block: clamp(48px, 6vw, 72px); border-bottom: 1px solid var(--line); overflow: hidden; }
  .brandband__head { display: grid; gap: 8px 48px; margin-bottom: 28px; }
  @media (min-width: 900px) { .brandband__head { grid-template-columns: 1fr 1.1fr; align-items: end; } }
  .brandband h2 { font-size: var(--step-2); margin: 0; max-width: 22ch; }
  .brandband p { color: var(--steel); margin: 0; max-width: 60ch; }
  .marq { --gap: 12px; display: flex; gap: var(--gap); width: 100%; padding-block: 6px; -webkit-mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marq__track { flex: none; display: flex; gap: var(--gap); list-style: none; margin: 0; padding: 0; min-width: 100%; justify-content: space-around; animation: marq var(--dur) linear infinite; }
  .marq--rev .marq__track { animation-direction: reverse; }
  .marq:hover .marq__track, .marq:focus-within .marq__track { animation-play-state: paused; }
  @keyframes marq { to { transform: translateX(calc(-100% - var(--gap))); } }
  .marq a, .marq span { display: inline-flex; align-items: center; min-height: 54px; padding: 10px 22px; border: 1px solid var(--line); border-radius: var(--r-s); background: var(--paper); color: var(--ink); text-decoration: none; white-space: nowrap; font: 700 1.08rem var(--f-display); font-stretch: 116%; letter-spacing: 0.01em; transition: border-color 200ms ease, color 200ms ease, background-color 200ms ease, transform 260ms var(--ease-out); }
  .marq a:hover, .marq a:focus-visible { border-color: var(--blue); color: var(--blue-deep); background: #fff; transform: translateY(-2px); }
  .marq + .marq { margin-top: 6px; }
  @media (prefers-reduced-motion: reduce) {
    .marq { -webkit-mask: none; mask: none; padding-inline: var(--gutter); max-width: var(--max); margin-inline: auto; }
    .marq__track { animation: none; flex-wrap: wrap; justify-content: flex-start; min-width: 0; }
    .marq__track[aria-hidden] { display: none; }
  }

  /* ---------- problema ---------- */
  .split { display: grid; gap: 36px; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1.1fr; gap: 80px; align-items: center; } .split--top { align-items: start; } }
  .asks { list-style: none; padding: 0; margin: 0 0 30px; display: grid; gap: 16px; }
  .asks li { position: relative; padding: 16px 18px 16px 58px; font-size: var(--step-1); font-weight: 500; line-height: 1.4; background: var(--paper); border-radius: var(--r-m); }
  .asks li::before { content: '?'; position: absolute; left: 16px; top: 16px; width: 28px; height: 28px; display: grid; place-items: center; font: 800 0.95rem var(--f-display); color: #fff; background: var(--blue-deep); border-radius: 6px; }
  .words { font-size: var(--step-1); line-height: 1.55; font-weight: 500; margin: 0; }
  :global(.js) .words .w { color: #6a7a86; transition: color 400ms ease; }
  :global(.js) .words .w.on { color: var(--ink); }

  /* ---------- cadena: el cable se energiza con el scroll y cada eslabón se enciende ---------- */
  .chain-head { max-width: 760px; margin-bottom: 52px; }
  .chain { --p: 0; list-style: none; padding: 0; margin: 0; display: grid; position: relative; }
  .chain::before, .chain::after { content: ''; position: absolute; left: 16px; top: 22px; bottom: 22px; width: 3px; border-radius: 3px; background: rgba(143, 208, 240, 0.18); }
  .chain::after { background: linear-gradient(var(--amber), var(--green)); transform-origin: 50% 0; transform: scaleY(var(--p)); box-shadow: 0 0 14px rgba(242, 179, 61, 0.55); }
  .chain li { position: relative; z-index: 1; }
  .chain a { display: grid; align-content: start; gap: 6px; padding: 18px 0 18px 54px; text-decoration: none; color: var(--on-night-2); }
  .chain a::before { content: ''; position: absolute; left: 4px; top: 22px; width: 27px; height: 18px; border: 2.5px solid var(--wire); border-radius: 9px; background: var(--night); transition: border-color 400ms ease, background-color 400ms ease, box-shadow 500ms ease; }
  .chain li.is-lit a::before { border-color: #5fd17f; background: #1f6e3a; box-shadow: 0 0 0 5px rgba(95, 209, 127, 0.16), 0 0 18px rgba(95, 209, 127, 0.5); }
  .chain strong { font: 650 var(--step-1) var(--f-display); color: #fff; font-stretch: 106%; transition: color 300ms ease; }
  .chain span { max-width: 56ch; }
  @media (hover: hover) { .chain a:hover strong { color: var(--sky); text-decoration: underline; text-underline-offset: 4px; } }
  @media (min-width: 980px) {
    .chain { grid-template-columns: repeat(6, 1fr); }
    .chain::before, .chain::after { left: 0; right: 30px; top: 9px; bottom: auto; width: auto; height: 3px; }
    .chain::after { background: linear-gradient(90deg, var(--amber), var(--green)); transform-origin: 0 50%; transform: scaleX(var(--p)); }
    .chain a { padding: 52px 22px 0 0; height: 100%; }
    .chain a::before { left: 0; top: 0; width: 38px; height: 21px; border-radius: 11px; }
    .chain strong { font-size: 1.14rem; }
    .chain span { font-size: 0.95rem; }
  }

  /* ---------- líneas principales ---------- */
  .sec-head { max-width: 780px; margin-bottom: 40px; }
  .sec-head--row { max-width: none; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; }
  .prio { display: grid; gap: 20px; }
  @media (min-width: 900px) { .prio { grid-template-columns: 1.2fr 1fr; grid-template-rows: auto auto; } .prio__it--big { grid-row: span 2; } }
