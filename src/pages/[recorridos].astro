---
// Guía visual para que CBPS revise la propuesta (pedido de Diego, 20-nov, tras la llamada del 19-nov):
// arquitectura + recorridos de cliente + qué pasa con cada solicitud. Solo existe en la vista previa.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { u, PREVIEW, waCotizar } from '../lib/site.js';
import { LINEAS, SERVICIOS, ARBOL } from '../lib/nav.js';
import { PAGINAS, POSTS } from '../lib/paginas.js';

export function getStaticPaths() {
  return PREVIEW ? [{ params: { recorridos: 'recorridos' } }] : [];
}

// Búsquedas y volúmenes: Semrush MX del plan SEO de Diego (nov-2026), los mismos de serp-plantillas-por-linea.csv
const RECORRIDOS = [
  { titulo: 'Se va la luz y la operación se detiene', busqueda: 'plantas de emergencia', volumen: '2,900', area: 'Plantas de emergencia',
    pasos: ['/productos/plantas-de-emergencia/', '/productos/plantas-de-emergencia/generac/', '/servicios/instalacion-y-dimensionamiento/plantas-de-emergencia/'] },
  { titulo: 'El UPS ya tiene años o empezó a fallar', busqueda: 'mantenimiento de UPS', volumen: '560', area: 'Mantenimiento de UPS',
    pasos: ['/servicios/mantenimiento/ups/', '/servicios/reparacion-y-modernizacion/ups/', '/productos/ups/eaton/'] },
  { titulo: 'Hay que cambiar el banco de baterías', busqueda: 'banco de baterías', volumen: '720', area: 'Baterías industriales',
    pasos: ['/productos/baterias-industriales/', '/productos/baterias-industriales/baterias-para-ups/', '/servicios/sustitucion-de-bancos-de-baterias/'] },
  { titulo: 'Un evento o una obra necesita energía unos días', busqueda: 'renta de plantas de emergencia', volumen: '170', area: 'Renta de equipos',
    pasos: ['/servicios/renta-de-plantas-de-emergencia/'] },
];
// si una ruta deja de existir en el sitio, el build falla aquí en vez de publicar un enlace roto
for (const r of RECORRIDOS) for (const p of r.pasos) if (!PAGINAS[p]) throw new Error(`recorridos: no existe ${p}`);

const nombre = (ruta) => {
  const n = ARBOL[ruta];
  const padre = n?.padre && ARBOL[n.padre];
  // páginas de marca: «Generac» → «Plantas de emergencia Generac»
  return padre && !n.resumen && !padre.padre?.startsWith('/servicios/') && padre.padre !== '/' ? `${padre.nombre.replace(/ \(.*\)$/, '')} ${n.nombre}` : n?.nombre || PAGINAS[ruta].h1;
};
const resumen = (ruta) => ARBOL[ruta]?.resumen || '';

const marcas = (l) => l.hijos.flatMap((h) => (h.hijos ? h.hijos : [h]));
const totalMarcas = new Set(LINEAS.flatMap((l) => marcas(l).map((m) => m.nombre))).size;
const CONTENIDO = [
  { ruta: '/blog/', nombre: 'Blog', nota: `${POSTS.length} artículos técnicos que enlazan a su producto o servicio` },
  { ruta: '/nosotros/', nombre: 'Nosotros', nota: 'Quiénes son, clientes y respaldo de marcas' },
  { ruta: '/promociones/', nombre: 'Promociones', nota: 'Ofertas vigentes' },
  { ruta: '/alianza-estrategica/', nombre: 'Alianza estratégica', nota: 'Para integradores y socios' },
  { ruta: '/libro-gratis/', nombre: 'Libro gratis', nota: 'Guía descargable a cambio de contacto' },
];
---
<Base title="El sitio nuevo en una vista" desc="Cómo se organiza el sitio nuevo de CBPS, cómo llega un cliente desde Google hasta la cotización y qué pasa con cada solicitud." ruta="/recorridos/" noindex>
  <div class="phero">
    <div class="wrap">
      <div class="phero__grid solo">
        <div>
          <h1>El sitio nuevo en una vista</h1>
          <p class="lead">Para revisar la propuesta no hace falta recorrer las {Object.keys(PAGINAS).length} páginas una por una. Aquí está cómo se organiza el sitio, qué camino sigue un cliente desde Google hasta pedir una cotización y a qué área llega cada solicitud. Cada recuadro abre la página real.</p>
        </div>
      </div>
    </div>
  </div>

  <section class="band band--white rc" aria-labelledby="rc-arq">
    <div class="wrap">
      <h2 id="rc-arq">Cómo se organiza</h2>
      <p class="rc__intro">Arriba, lo que CBPS vende; abajo, lo que da confianza para comprar. Todo cuelga de la página de inicio y ninguna página queda a más de tres clics.</p>

      <div class="arq">
        <a class="arq__raiz" href={u('/')}>Inicio</a>
        <div class="arq__ramas">
          <div class="arq__rama">
            <a class="arq__h" href={u('/productos/')}>Productos</a>
            <p class="arq__cuenta">{LINEAS.length} líneas · {totalMarcas} marcas</p>
            <ul>
              {LINEAS.map((l) => (
                <li><a href={u(l.ruta)}>{l.nombre}</a>
                  {marcas(l).length > 0 && <span class="arq__marcas">{marcas(l).map((m, i) => <>{i > 0 && ', '}<a href={u(m.ruta)}>{m.nombre}</a></>)}</span>}
                </li>
              ))}
            </ul>
          </div>
          <div class="arq__rama">
            <a class="arq__h" href={u('/servicios/')}>Servicios</a>
            <p class="arq__cuenta">{SERVICIOS.length} servicios</p>
            <ul>
              {SERVICIOS.map((s) => (
                <li><a href={u(s.ruta)}>{s.nombre}</a>
                  {s.hijos.length > 0 && <span class="arq__marcas">{s.hijos.map((h, i) => <>{i > 0 && ', '}<a href={u(h.ruta)}>{h.nombre}</a></>)}</span>}
                </li>
              ))}
            </ul>
          </div>
          <div class="arq__rama">
            <p class="arq__h arq__h--txt">Confianza y contenido</p>
            <p class="arq__cuenta">Lo que convence antes de cotizar</p>
            <ul>
              {CONTENIDO.map((c) => <li><a href={u(c.ruta)}>{c.nombre}</a><span class="arq__marcas">{c.nota}</span></li>)}
            </ul>
          </div>
          <div class="arq__rama arq__rama--cta">
            <a class="arq__h" href={u('/contacto/')}>Contacto</a>
            <p class="arq__cuenta">Siempre a un clic</p>
            <ul>
              <li>Formulario de cotización al final de cada página de producto y servicio</li>
              <li>WhatsApp y teléfono fijos en la cabecera</li>
              <li><a href={u('/contacto/')}>Página de contacto</a> con dirección y mapa</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band rc" aria-labelledby="rc-rec">
    <div class="wrap">
      <h2 id="rc-rec">Cómo llega un cliente hasta la cotización</h2>
      <p class="rc__intro">Cuatro casos reales, armados con lo que la gente busca en Google México cada mes. Síguelos con clic y fíjate si el camino y los textos se parecen a cómo venden ustedes.</p>

      <div class="recs">
        {RECORRIDOS.map((r) => (
          <article class="rec">
            <h3>{r.titulo}</h3>
            <ol class="rec__flujo">
              <li class="rec__paso rec__paso--google">
                <span class="rec__q">«{r.busqueda}»</span>
                <span class="rec__d">Búsqueda en Google · {r.volumen} al mes en México</span>
              </li>
              {r.pasos.map((p) => (
                <li class="rec__paso">
                  <a href={u(p)}>{nombre(p)}</a>
                  {resumen(p) && <span class="rec__d">{resumen(p)}</span>}
                </li>
              ))}
              <li class="rec__paso rec__paso--fin">
                <a href={`${u(r.pasos[r.pasos.length - 1])}#cotizar`}>Pide su cotización</a>
                <span class="rec__d">Llega marcada como «{r.area}», o escribe por <a href={waCotizar(r.area.toLowerCase())} target="_blank" rel="noopener">WhatsApp</a></span>
              </li>
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--night rc" aria-labelledby="rc-ops">
    <div class="wrap">
      <h2 id="rc-ops">Qué pasa con cada solicitud</h2>
      <ol class="ops">
        <li><strong>Llega a la página correcta</strong><span>Cada producto, marca y servicio tiene su página, escrita para la búsqueda que hace ese cliente.</span></li>
        <li><strong>El formulario ya sabe el área</strong><span>Si escribe desde Plantas de emergencia, la solicitud sale marcada como «Plantas de emergencia». Son 10 áreas; si no está seguro, elige «Otro».</span></li>
        <li><strong>Se guarda y avisa al área</strong><span>Cada solicitud queda registrada y se avisa al correo de esa área. Si algo falla, el cliente sigue por WhatsApp o correo: no se pierde ninguna.</span></li>
        <li><strong>Un ingeniero responde</strong><span>Con una propuesta técnica para su caso, no con un catálogo.</span></li>
        <li><strong>Queda medido</strong><span>Al publicar, cada solicitud se cuenta en Google Analytics: sabremos qué páginas y qué búsquedas traen clientes.</span></li>
      </ol>
      <p class="ops__nota">Antes del lanzamiento definimos con ustedes a qué correo o CRM llega cada área.</p>
    </div>
  </section>

  <section class="band band--white rc" aria-labelledby="rc-nec">
    <div class="wrap rc__cierre">
      <h2 id="rc-nec">Lo que necesitamos de ustedes</h2>
      <ul class="nec">
        <li>¿Las líneas, marcas y servicios del mapa son los que venden hoy? Si falta o sobra alguno, nos dicen cuál.</li>
        <li>¿Los cuatro recorridos se parecen a cómo llegan sus clientes? Si hay otro caso frecuente, lo agregamos.</li>
        <li>¿A qué correo o persona debe llegar cada área?</li>
      </ul>
      <p class="rc__intro">El sitemap técnico y el mapa de redirecciones de las páginas actuales van en la entrega final, con el listado de páginas que aprueben aquí.</p>
      <div class="btns" style="margin-top:28px">
        <a class="btn" href={u('/')}>Ver la página de inicio<Icono n="flecha" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .rc h2 { font-size: var(--step-3); max-width: 24ch; }
  .rc__intro { max-width: 62ch; margin-top: 14px; color: var(--steel); font-size: var(--step-0); line-height: 1.55; }
  .band--night .rc__intro, .band--night h2 { color: var(--on-night); }

  /* árbol: raíz arriba, cuatro ramas debajo unidas por un cable */
  .arq { margin-top: 40px; }
  .arq__raiz { display: inline-flex; align-items: center; min-height: 48px; padding: 10px 22px; border-radius: var(--r-m); background: var(--night); color: #fff; font: 600 var(--step-1)/1.1 var(--f-display); text-decoration: none; }
  .arq__ramas { display: grid; gap: 16px; margin-top: 28px; position: relative; padding-left: 22px; }
  .arq__ramas::before { content: ''; position: absolute; left: 0; top: -28px; bottom: 24px; width: 2px; background: var(--line); }
  .arq__rama { position: relative; padding: 20px 22px; border-radius: var(--r-m); background: var(--paper); }
  .arq__rama::before { content: ''; position: absolute; left: -22px; top: 32px; width: 22px; height: 2px; background: var(--line); }
  .arq__rama--cta { background: var(--blue-wash); }
  .arq__h { font: 600 var(--step-1)/1.2 var(--f-display); color: var(--ink); text-decoration: none; }
  a.arq__h:hover { color: var(--blue-deep); text-decoration: underline; }
  .arq__cuenta { margin-top: 4px; color: var(--steel); font-size: var(--step--1); }
  .arq__rama ul { margin-top: 14px; display: grid; gap: 10px; }
  .arq__rama li { line-height: 1.4; }
  .arq__rama li > a { font-weight: 600; color: var(--blue-deep); }
  .arq__marcas { display: block; font-size: var(--step--1); color: var(--steel); }
  .arq__marcas a { color: inherit; }
  .arq__marcas a:hover { color: var(--blue-deep); }
  @media (min-width: 900px) {
    .arq { text-align: center; }
    .arq__ramas { grid-template-columns: repeat(4, minmax(0, 1fr)); padding-left: 0; padding-top: 28px; margin-top: 0; text-align: left; }
    .arq__ramas::before { left: 12.5%; right: 12.5%; top: 0; bottom: auto; width: auto; height: 2px; }
    .arq__rama::before { left: 50%; top: -28px; width: 2px; height: 28px; }
    .arq__raiz { position: relative; margin-bottom: 28px; }
    .arq__raiz::after { content: ''; position: absolute; left: 50%; top: 100%; width: 2px; height: 28px; background: var(--line); }
  }

  /* recorridos: pasos unidos por una línea que se «energiza» de azul a verde */
  .recs { display: grid; gap: 20px; margin-top: 36px; }
  .rec { padding: clamp(20px, 3vw, 30px); border-radius: var(--r-l); background: var(--surface); box-shadow: var(--shadow); }
  .rec h3 { font-size: var(--step-2); }
  .rec__flujo { display: grid; gap: 0; margin-top: 20px; list-style: none; padding: 0; }
  .rec__paso { position: relative; display: grid; gap: 4px; padding: 0 0 22px 30px; }
  .rec__paso::before { content: ''; position: absolute; left: 6px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--surface); border: 2px solid var(--blue); }
  .rec__paso::after { content: ''; position: absolute; left: 11px; top: 22px; bottom: 2px; width: 2px; background: linear-gradient(var(--blue), var(--green)); }
  .rec__paso:last-child { padding-bottom: 0; }
  .rec__paso:last-child::after { display: none; }
  .rec__paso--fin::before { background: var(--green); border-color: var(--green); }
  .rec__paso > a { font-weight: 600; color: var(--blue-deep); }
  .rec__q { font: 600 var(--step-1)/1.25 var(--f-display); color: var(--ink); }
  .rec__d { font-size: var(--step--1); color: var(--steel); line-height: 1.45; max-width: 52ch; }
  .rec__d a { color: var(--green-deep); font-weight: 600; }
  @media (min-width: 900px) {
    .recs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* operación: cinco estaciones sobre el tablero, la corriente en ámbar */
  .ops { display: grid; gap: 0; margin-top: 36px; list-style: none; padding: 0; counter-reset: none; }
  .ops li { position: relative; display: grid; gap: 6px; padding: 0 0 26px 34px; }
  .ops li::before { content: ''; position: absolute; left: 4px; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--night); border: 2px solid var(--amber); }
  .ops li::after { content: ''; position: absolute; left: 11px; top: 24px; bottom: 2px; width: 2px; background: var(--amber); opacity: 0.7; }
  .ops li:last-child::after { display: none; }
  .ops strong { font: 600 var(--step-1)/1.2 var(--f-display); color: #fff; }
  .ops span { color: var(--on-night-2); max-width: 46ch; line-height: 1.5; }
  .ops__nota { margin-top: 18px; color: var(--sky); }
  @media (min-width: 1000px) {
    .ops { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; }
    .ops li { padding: 34px 0 0; }
    .ops li::before { left: 0; top: 0; }
    .ops li::after { left: 20px; right: -20px; top: 7px; bottom: auto; width: auto; height: 2px; }
  }

  .rc__cierre .nec { margin-top: 20px; display: grid; gap: 12px; max-width: 66ch; padding-left: 1.2em; }
  .nec li { line-height: 1.5; }
</style>
