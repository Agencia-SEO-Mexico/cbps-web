---
import Base from '../layouts/Base.astro';
import Secciones from '../components/Secciones.astro';
import Cotizar from '../components/Cotizar.astro';
import Icono from '../components/Icono.astro';
import Foto from '../components/Foto.astro';
import { existsSync } from 'node:fs';
import { PAGINAS, POSTS, VIEJAS } from '../lib/paginas.js';
import { ARBOL, migas, hermanos, hijos, LINEAS, SERVICIOS, MATRIZ } from '../lib/nav.js';
import { u, PROD, PREVIEW, waCotizar, waOrientacion } from '../lib/site.js';
import { slug, tc } from '../lib/util.js';

export function getStaticPaths() {
  const paths = Object.keys(PAGINAS).filter((r) => r !== '/').map((r) => ({ params: { ruta: r.replace(/^\/|\/$/g, '') }, props: { ruta: r } }));
  const nuevas = new Set(Object.keys(PAGINAS));
  // páginas puente solo en la vista previa: en producción las URLs viejas responden con 301 de servidor
  // (lanzamiento/_redirects); un archivo en esa ruta taparía el 301 en Netlify/Cloudflare Pages.
  if (PREVIEW) for (const [vieja, nueva] of Object.entries(VIEJAS)) if (!nuevas.has(vieja)) paths.push({ params: { ruta: vieja.replace(/^\/|\/$/g, '') }, props: { ruta: vieja, puente: nueva } });
  return paths;
}
const { ruta, puente } = Astro.props;
const p = puente ? null : PAGINAS[ruta];
const esBlog = ruta === '/blog/';
const esPost = !puente && ruta.startsWith('/blog/') && !esBlog;
const crumbs = puente ? [] : esPost ? [{ ruta: '/', nombre: 'Inicio' }, { ruta: '/blog/', nombre: 'Blog' }, { ruta, nombre: p.h1 }] : migas(ruta, p?.h1);
const linea = LINEAS.find((l) => ruta.startsWith(l.ruta)) || SERVICIOS.find((s) => ruta.startsWith(s.ruta));
const tema = linea?.corto || (ruta.includes('bateria') ? 'Baterías' : '');
const nombreCorto = ARBOL[ruta]?.nombre || p?.h1;
const kids = puente || esBlog ? [] : hijos(ruta).map((k) => ({ ...k, resumen: PAGINAS[k.ruta]?.desc || k.resumen }));
const bros = puente || esPost || (ARBOL[ruta]?.padre || '/') === '/' ? [] : hermanos(ruta).filter((b) => !b.ruta.startsWith('/blog/')).slice(0, 12);
const relacionados = (p?.related || []).filter((r) => !PAGINAS[r]?.noindex).map((r) => ({ ruta: r, nombre: ARBOL[r]?.nombre || PAGINAS[r]?.h1 || r }));
const toc = (p?.sections || []).filter((s) => s.h).map((s) => ({ id: slug(s.h), h: tc(s.h) }));
const esProducto = ruta.startsWith('/productos/');
const esServicio = ruta.startsWith('/servicios/');
// matriz de servicios de CBPS (reporte de observaciones 3.2) en la línea y en las páginas de sus marcas
const lineaM = esProducto ? LINEAS.find((l) => l.matriz && ruta.startsWith(l.ruta)) : null;
const PAG_SERV = {
  plantas: { 'Instalación': '/servicios/instalacion-y-dimensionamiento/plantas-de-emergencia/', 'Mantenimiento preventivo': '/servicios/mantenimiento/plantas-de-emergencia/', 'Mantenimiento correctivo': '/servicios/mantenimiento/plantas-de-emergencia/', 'Renta': '/servicios/renta-de-plantas-de-emergencia/' },
  ups: { 'Mantenimiento preventivo': '/servicios/mantenimiento/ups/', 'Mantenimiento correctivo': '/servicios/reparacion-y-modernizacion/ups/', 'Actualización de infraestructura': '/servicios/reparacion-y-modernizacion/ups/', 'Renta': '/servicios/renta-y-financiamiento-de-ups-trifasico/', 'Reemplazo de batería': '/servicios/sustitucion-de-bancos-de-baterias/' },
  baterias: { 'Reemplazo de batería': '/servicios/sustitucion-de-bancos-de-baterias/' },
};
const servLinea = lineaM ? MATRIZ[lineaM.matriz].map((s) => ({ s, r: PAG_SERV[lineaM.matriz]?.[s] })) : [];
// marcas que CBPS pidió agregar y aún no tienen página propia, y accesorios de la línea
const nodo = (function buscar(lista) { for (const n of lista) { if (n.ruta === ruta) return n; const k = n.hijos && buscar(n.hijos); if (k) return k; } return null; })(LINEAS);
const marcasSinPagina = nodo?.marcas || [];
const accesorios = nodo?.accesorios || [];
// servicios que se cruzan con cada línea de producto (y al revés)
const cruces = esProducto
  ? (ruta.includes('plantas') || ruta.includes('tableros') ? ['/servicios/mantenimiento/plantas-de-emergencia/', '/servicios/instalacion-y-dimensionamiento/plantas-de-emergencia/', '/servicios/renta-de-plantas-de-emergencia/']
    : ruta.includes('/ups/') ? ['/servicios/mantenimiento/ups/', '/servicios/reparacion-y-modernizacion/ups/', '/servicios/renta-y-financiamiento-de-ups-trifasico/']
    : ruta.includes('bateria') ? ['/servicios/sustitucion-de-bancos-de-baterias/', '/servicios/mantenimiento/ups/'] : ['/servicios/', '/servicios/instalacion-y-dimensionamiento/'])
  : esServicio ? (ruta.includes('plantas') ? ['/productos/plantas-de-emergencia/', '/servicios/mantenimiento/plantas-de-emergencia/', '/servicios/instalacion-y-dimensionamiento/plantas-de-emergencia/', '/servicios/renta-de-plantas-de-emergencia/', '/productos/tableros-de-transferencia/'] : ruta.includes('ups') ? ['/productos/ups/', '/productos/baterias-industriales/baterias-para-ups/'] : ruta.includes('bateria') ? ['/productos/baterias-industriales/baterias-para-ups/', '/productos/baterias-industriales/'] : ['/productos/plantas-de-emergencia/', '/productos/ups/', '/productos/baterias-industriales/'])
  : [];
const crucesL = cruces.filter((r) => r !== ruta && !PAGINAS[r]?.noindex).map((r) => ({ ruta: r, nombre: ARBOL[r]?.nombre || PAGINAS[r]?.h1 }));

// Service.name = nombre corto (title sin « | …»); si coincide con el H1, el nombre del menú
const tCorto = (p?.title || '').split(' | ')[0].trim();
const nombreServicio = tCorto && tc(tCorto) !== tc(p?.h1 || '') ? tCorto : (nombreCorto && tc(nombreCorto) !== tc(p?.h1 || '') ? nombreCorto : tCorto);
// og:image propia: la del héroe (producto o línea) o la primera imagen grande del contenido; si no hay, la general
const primeraImg = p ? (p.sections || []).flatMap((s) => s.body || []).flatMap((b) => b.t === 'img' ? [b] : b.t === 'imgs' ? b.items : []).find((im) => (im.w || 0) >= 400) : null;
const imgPropia = p?.media?.src || primeraImg?.src;
const ogImage = imgPropia ? `/img/${imgPropia}` : undefined;
const faqs = (p?.faqs || []).filter((f) => f.a?.length);
const schema = [];
if (!puente) {
  schema.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.nombre, item: `${PROD}${c.ruta}` })) });
  if (faqs.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.map((a) => a.x || (a.items || []).join('; ')).join(' ') } })) });
  if (esProducto || esServicio) schema.push({ '@context': 'https://schema.org', '@type': 'Service', name: nombreServicio, description: p.desc, serviceType: nombreCorto, provider: { '@id': `${PROD}/#negocio` }, areaServed: { '@type': 'Country', name: 'México' }, url: `${PROD}${ruta}` });
  if (esPost) schema.push({ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: p.h1, description: p.desc, datePublished: p.published || undefined, dateModified: p.modified || p.published || undefined, author: { '@type': 'Organization', name: 'CBPS' }, image: `${PROD}${ogImage || '/og-cbps.jpg'}`, publisher: { '@id': `${PROD}/#negocio` }, mainEntityOfPage: `${PROD}${ruta}` });
}
// imagen del héroe (LCP en móvil): precarga de su AVIF responsive si existe
const lcpBase = p?.media?.src?.replace(/\.webp$/, '');
const lcp = lcpBase && existsSync(`public/img/r/${lcpBase}.avif`) ? { srcset: `${u('/img/r/' + lcpBase + '-560.avif')} 560w, ${u('/img/r/' + lcpBase + '.avif')} ${p.media.w}w`, sizes: '(min-width: 900px) 40vw, 92vw' } : null;
const fecha = (iso) => iso ? new Date(iso).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Mexico_City' }) : '';
const etiqueta = esPost ? 'Blog Electric Leaders' : esProducto ? (linea && linea.ruta !== ruta ? linea.nombre : 'Productos') : esServicio ? 'Servicios' : 'CBPS';
---
{puente ? (
  <html lang="es-MX">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Esta página cambió de dirección | CBPS</title>
      <meta name="robots" content="noindex,nofollow" />
      <link rel="canonical" href={`${PROD}${ruta}`} />
      <meta http-equiv="refresh" content={`0; url=${u(puente)}`} />
      <style>body{font:16px/1.6 system-ui,sans-serif;background:#f3f6f8;color:#15212b;display:grid;place-items:center;min-height:100vh;margin:0;padding:16px}a{color:#0b5f8a}</style>
    </head>
    <body><p>Esta página ahora está en <a href={u(puente)}>{`${PROD}${puente}`}</a>.</p></body>
  </html>
) : (
<Base title={p.title} desc={p.desc} ruta={ruta} canon={p.canon} schema={schema} tipo={esPost ? 'article' : 'website'} noindex={!!p.noindex} lcp={lcp} ogImage={ogImage}>
  <div class="phero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Migas de pan"><ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={u(c.ruta)}>{c.nombre}</a> : <span aria-current="page">{c.nombre}</span>}</li>)}</ol></nav>
      <div class={`phero__grid${p.media ? '' : ' solo'}`}>
        <div>
          <p class="phero__tag">{etiqueta}{esPost && p.published && <> · <time datetime={p.published}>{fecha(p.published)}</time></>}</p>
          <h1>{tc(p.h1)}</h1>
          {p.lead && <p class="lead">{p.lead}</p>}
          {!esBlog && (
            <div class="btns" style="margin-top:24px">
              <a class="btn btn--wa" href={waCotizar(nombreCorto, ruta)} target="_blank" rel="noopener" data-ev="whatsapp"><Icono n="wa" />Cotizar por WhatsApp</a>
              <a class="btn btn--ghost" href={waOrientacion(nombreCorto, ruta)} target="_blank" rel="noopener" data-ev="whatsapp-orientacion">Pedir orientación técnica</a>
            </div>
          )}
        </div>
        {p.media && <div class="phero__media"><Foto src={p.media.src} alt={p.media.alt || p.h1} w={p.media.w} h={p.media.h} prioridad sizes="(min-width: 900px) 40vw, 92vw" /></div>}
      </div>
    </div>
  </div>

  {kids.length > 0 && (
    <section class="band band--white" aria-labelledby="k-t" style="padding-block:48px 56px">
      <div class="wrap">
        <h2 id="k-t" class="rv" style="font-size:var(--step-2)">{esServicio ? 'Servicios en esta sección' : ruta === '/productos/' ? 'Líneas de producto' : 'Marcas y opciones'}</h2>
        <ul class="rows">
          {kids.map((k) => (
            <li><a href={u(k.ruta)}><strong>{k.nombre}</strong>{k.resumen && <span>{k.resumen}</span>}<Icono n="flecha" /></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {esBlog ? (
    <section class="wrap" style="padding-block:48px 72px" aria-label="Artículos">
      <ul class="rows">
        {POSTS.map((q) => (
          <li><a href={u(q.ruta)}><strong>{tc(q.h1)}</strong><span>{fecha(q.published)}{q.desc ? ' · ' + q.desc : ''}</span><Icono n="flecha" /></a></li>
        ))}
      </ul>
    </section>
  ) : (
    <div class="wrap doc">
      <article>
        <Secciones secciones={p.sections} titulo={p.h1} />
        {marcasSinPagina.length > 0 && (
          <section class="sec" aria-labelledby="mar-t">
            <h2 id="mar-t" style="font-size:var(--step-2)">{nodo?.hijos?.length ? 'Otras marcas que maneja CBPS en esta línea' : 'Marcas que maneja CBPS en esta línea'}</h2>
            <ul class="lista-cols">{marcasSinPagina.map((m) => <li>{m}</li>)}</ul>
          </section>
        )}
        {accesorios.length > 0 && (
          <section class="sec" aria-labelledby="acc-t">
            <h2 id="acc-t" style="font-size:var(--step-2)">Accesorios</h2>
            <ul>{accesorios.map((a) => <li>{a}</li>)}</ul>
          </section>
        )}
        {servLinea.length > 0 && (
          <section class="sec" aria-labelledby="mat-t">
            <h2 id="mat-t" style="font-size:var(--step-2)">Servicios para {lineaM.nombre.charAt(0).toLowerCase() + lineaM.nombre.slice(1)}</h2>
            <p>Además del suministro del equipo, CBPS ofrece estos servicios para esta línea. Pide el que necesitas en el formulario o por WhatsApp.</p>
            <ul class="lista-cols">{servLinea.map(({ s, r }) => <li>{r ? <a href={u(r)}>{s}</a> : s}</li>)}</ul>
          </section>
        )}
        {esPost && (p.words || 0) < 120 && (
          <aside class="sec" aria-label="Más información">
            <h2 style="font-size:var(--step-2)">¿Necesitas aplicar esto en tu instalación?</h2>
            <p>Este artículo resume un tema técnico. Si tienes una duda concreta sobre tu equipo o tu instalación, un ingeniero de CBPS te orienta sin costo.</p>
          </aside>
        )}
        {(relacionados.length > 0 || crucesL.length > 0) && (
          <section class="sec" aria-labelledby="rel-t">
            <h2 id="rel-t" style="font-size:var(--step-2)">{esProducto ? 'Servicios para este equipo' : esServicio ? 'Equipos y servicios relacionados' : 'Te puede interesar'}</h2>
            <ul class="chips">{[...relacionados, ...crucesL].map((r) => <li><a href={u(r.ruta)}>{r.nombre}</a></li>)}</ul>
          </section>
        )}
        {bros.length > 0 && (
          <section class="sec" aria-labelledby="her-t">
            <h2 id="her-t" style="font-size:var(--step-2)">{esProducto ? 'También en ' + (ARBOL[ARBOL[ruta]?.padre]?.nombre || 'productos') : 'Otras páginas de esta sección'}</h2>
            <ul class="chips">{bros.map((b) => <li><a href={u(b.ruta)}>{b.nombre}</a></li>)}</ul>
          </section>
        )}
      </article>
      <aside class="aside" aria-label="Contacto y contenido">
        <div class="quote">
          <h2>{esPost ? '¿Tienes una duda técnica?' : `Cotiza ${(esProducto || esServicio) && nombreCorto && nombreCorto.length < 34 ? (esServicio ? nombreCorto.charAt(0).toLowerCase() + nombreCorto.slice(1) : nombreCorto) : 'con CBPS'}`}</h2>
          <p>Respuesta de un ingeniero, con propuesta técnica para tu operación.</p>
          <div class="btns">
            <a class="btn btn--wa" href={waCotizar(nombreCorto, ruta)} target="_blank" rel="noopener" data-ev="whatsapp"><Icono n="wa" />WhatsApp</a>
            <a class="btn btn--light" href="#cotizar">Formulario de cotización</a>
          </div>
        </div>
        {toc.length >= 3 && (
          <nav class="toc" aria-label="En esta página"><h2>En esta página</h2><ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.h}</a></li>)}</ol></nav>
        )}
      </aside>
    </div>
  )}
  <Cotizar tema={tema} ruta={ruta} />
</Base>
)}
